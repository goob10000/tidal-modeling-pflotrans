#==============================================================================
# PFLOTRAN Input Deck
# Description: Stepped Hydrothermal Ridge System with Variable Depth Grid
#==============================================================================

# Pressure with increasing flow rate

# 
# 

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
END

SUBSURFACE

#=========================== discretization ===================================
# Domain bounds: X in [0, 15000], Y in [0, 1], Z in [-5000, 0]
# 1. Top aquifer sits centered at X = 5000 to 10000.

GRID
  TYPE STRUCTURED
  NXYZ 372 1 116
  
  # ORIGIN sets the minimum bound (-5000 in Z)
  ORIGIN 0.d0 0.d0 -5000.d0
  
  DXYZ
    # DX:
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    240*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0 
    
    # DY:
    1.d0
    
    # DZ:
    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0 
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY crust1
  ID 1
  POROSITY 0.10d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14 
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust1
  ID 2
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY crust2
  ID 1
  POROSITY 0.10d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-13 
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY crust3
  ID 1
  POROSITY 0.10d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-12 
  /
  CHARACTERISTIC_CURVES cc1
/

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
    SMOOTH
  /
END

#=========================== output options ===================================
OUTPUT
  TIMES yr 5.d5 10.d5 15.d5 20.d5 25.d5 30.d5 35.d5 40.d5 45.d5 50.d5
  FORMAT TECPLOT BLOCK
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 50.d5 yr
  INITIAL_TIMESTEP_SIZE 1.d2 yr # Reduced slightly to handle the initial transient of a deeper model
  MAXIMUM_TIMESTEP_SIZE 1.d5 yr
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    15000.d0 1.d0 -5000.d0
  /
END

# 1. Total Deep Region (-5000 to -1000 m, X: 0 to 15000)
REGION deep_layer
  COORDINATES
    0.d0     0.d0   -5000.d0
    15000.d0 1.d0   -1000.d0
  /
END

# 2. Upper Layer / Aquifer (-1000 to -50 m, Centered X: 5000 to 10000)
REGION upper_layer
  COORDINATES
    5000.d0  0.d0   -1000.d0
    10000.d0 1.d0    -50.d0
  /
END

# 3. Cap Layer (-50 to 0 m, Centered X: 5000 to 10000)
REGION cap_layer
  COORDINATES
    5000.d0  0.d0    -50.d0
    10000.d0 1.d0      0.d0
  /
END

REGION top
  COORDINATES
    5000.d0 0.d0 -1000.d0
    10000.d0 1.d0 0.d0
  /
END

REGION upper_left
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
END

REGION upper_right
  COORDINATES
    10000.d0 0.d0 -1000.d0
    15000.d0 1.d0 0.d0
  /
END

#=========================== Boundaries ==========================================
REGION top_ocean_floor
  COORDINATES
    5000.d0  0.d0   0.d0
    10000.d0 1.d0   0.d0
  /
  FACE TOP
END

REGION bottom_heat_source
  COORDINATES
    0.d0     0.d0   -5000.d0
    15000.d0 1.d0   -5000.d0
  /
  FACE BOTTOM
END

REGION top_left_hydrostat
  COORDINATES
    5000.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
  FACE WEST
END

REGION top_right_hydrostat
  COORDINATES
    10000.d0 0.d0 -1000.d0
    10000.d0 1.d0 0.d0
  /
  FACE EAST
END

REGION bottom_left
  COORDINATES
    0.d0 0.d0 -5000.d0
    0.d0 1.d0 -1000.d0
  /
  FACE WEST
END

REGION bottom_right
  COORDINATES
    15000.d0 0.d0 -5000.d0
    15000.d0 1.d0 -1000.d0
  /
  FACE EAST
END

REGION right_cap
  COORDINATES
    10000.d0 0.d0 -1000.d0
    15000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

REGION left_cap
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

#=========================== flow conditions ==================================
FLOW_CONDITION seafloor_bc
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 0.d0 m/yr
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION bottom_heating
  TYPE
    LIQUID_FLUX NEUMANN
    ENERGY_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0 m/yr
  ENERGY_FLUX 0.11d0 W/m^2
END

FLOW_CONDITION initial_crust
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION side_bc
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 0.d0 m/yr
  TEMPERATURE 2.d0 C
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial_crust
  REGION all
END

BOUNDARY_CONDITION seafloor
  FLOW_CONDITION seafloor_bc
  REGION top_ocean_floor
END

BOUNDARY_CONDITION basal_heat
  FLOW_CONDITION bottom_heating
  REGION bottom_heat_source
END

BOUNDARY_CONDITION top_right_edge_bc
  FLOW_CONDITION side_bc
  REGION top_right_hydrostat
END

BOUNDARY_CONDITION left_edge_bc
  FLOW_CONDITION side_bc
  REGION top_left_hydrostat
END

#=========================== stratigraphy couplers ============================
# Only active regions get assigned materials. Unassigned space (X<5000 & X>10000 above Z=-1000)
# is treated as inactive void by PFLOTRAN.

STRATA
  REGION cap_layer
  MATERIAL crust1
END

STRATA
  REGION upper_layer
  MATERIAL crust1
  START_TIME 0.d0 y
  FINAL_TIME 1.d6 y
END

STRATA
  REGION upper_layer
  MATERIAL crust2
  START_TIME 1.d0 y
  FINAL_TIME 2.d6 y
END

STRATA
  REGION upper_layer
  MATERIAL crust3
  START_TIME 2.d0 y
  FINAL_TIME 3.d6 y
END

STRATA
  REGION upper_layer
  MATERIAL crust4
  START_TIME 3.d0 y
  FINAL_TIME 4.d6 y
END

STRATA
  REGION upper_left
  INACTIVE
END

STRATA
  REGION upper_right
  INACTIVE
END

STRATA
  REGION deep_layer
  MATERIAL deep_crust1
END


#==============================================================================