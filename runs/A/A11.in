#==============================================================================
# PFLOTRAN Input Deck
# Description: 2D Hydrothermal Ridge and Flank System (5 km Deep)
# Mode: TH (Thermal-Hydrology)
#==============================================================================

# Testing:
# Reduced cell count to 200x200 (which is 25mx25m cells to reduce computational load.)
# This sim has the heated lower layer.
#


SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
END

SUBSURFACE

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 200 1 200
  BOUNDS
    0.d0   0.d0   -5000.d0
    5000.d0 1.d0     0.d0  
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY crust
  ID 1
  POROSITY 0.10d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14 
  /
  CHARACTERISTIC_CURVES cc1
/

# NEW: Deep crust material (0.5% porosity, permeability starts at 1.d-16)
MATERIAL_PROPERTY deep_crust1
  ID 2
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust2
  ID 3
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-15
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust3
  ID 4
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-16
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust4
  ID 5
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-17
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust5
  ID 6
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-18
  /
  CHARACTERISTIC_CURVES cc1
/

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
    SMOOTH
  /
END

#=========================== output options ===================================
OUTPUT
  TIMES yr 5.d5 10.d5 15.d5 20.d5 25.d5 30.d5 35.d5 40.d5 45.d5 50.d5
  FORMAT TECPLOT BLOCK
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 50.d5 yr
  INITIAL_TIMESTEP_SIZE 1.d2 yr # Reduced slightly to handle the initial transient of a deeper model
  MAXIMUM_TIMESTEP_SIZE 1.d5 yr
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0   0.d0   -5000.d0
    5000.d0 1.d0     0.d0
  /
END

# NEW: Stratum region for upper crust (0 to -1 km)
REGION upper_layer
  COORDINATES
    0.d0   0.d0   -1000.d0
    5000.d0 1.d0     0.d0
  /
END

# NEW: Stratum region for deep crust (-1 km to -5 km)
REGION deep_layer
  COORDINATES
    0.d0   0.d0   -5000.d0
    5000.d0 1.d0   -1000.d0
  /
END

REGION top_ocean_floor
  COORDINATES
    0.d0   0.d0   0.d0
    5000.d0 1.d0   0.d0
  /
  FACE TOP
END

# Adjusted: Heat source moved down to -5 km
REGION bottom_heat_source
  COORDINATES
    0.d0   0.d0   -5000.d0
    5000.d0 1.d0   -5000.d0
  /
  FACE BOTTOM
END

# Adjusted: Right boundary extended down to -5 km
REGION right_edge
  COORDINATES
    5000.d0 0.d0 -5000.d0
    5000.d0 1.d0    0.d0
  /
  FACE EAST
END

# Adjusted: Left boundary extended down to -5 km
REGION left_edge
  COORDINATES
    0.d0 0.d0 -5000.d0
    0.d0 1.d0    0.d0
  /
  FACE WEST
END

#=========================== flow conditions ==================================
FLOW_CONDITION seafloor_bc
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE DIRICHLET
  /
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION bottom_heating
  TYPE
    LIQUID_FLUX NEUMANN
    ENERGY_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0 m/yr
  ENERGY_FLUX 0.11d0 W/m^2
END

# Adjusted initial condition to scale hydrostatically down to -5 km
FLOW_CONDITION initial_crust
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION right_hydrostatic_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION left_hydrostatic_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 20001.d3 Pa
  TEMPERATURE 2.d0 C
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial_crust
  REGION all
END

BOUNDARY_CONDITION seafloor
  FLOW_CONDITION seafloor_bc
  REGION top_ocean_floor
END

BOUNDARY_CONDITION basal_heat
  FLOW_CONDITION bottom_heating
  REGION bottom_heat_source
END

BOUNDARY_CONDITION right_edge_bc
  FLOW_CONDITION right_hydrostatic_bc
  REGION right_edge
END

BOUNDARY_CONDITION left_edge_bc
  FLOW_CONDITION left_hydrostatic_bc
  REGION left_edge
END

#=========================== stratigraphy couplers ============================
# Adjusted: The domain is now split between the upper and deep crust layers
STRATA
  REGION upper_layer
  MATERIAL crust
END

STRATA
  REGION deep_layer
  MATERIAL deep_crust1
  START_TIME 0.d0 y
  FINAL_TIME 1.d6 y
END

STRATA
  REGION deep_layer
  MATERIAL deep_crust2
  START_TIME 1.d6 y
  FINAL_TIME 2.d6 y
END

STRATA
  REGION deep_layer
  MATERIAL deep_crust3
  START_TIME 2.d6 y
  FINAL_TIME 3.d6 y
END

STRATA
  REGION deep_layer
  MATERIAL deep_crust4
  START_TIME 3.d6 y
  FINAL_TIME 4.d6 y
END

STRATA
  REGION deep_layer
  MATERIAL deep_crust5
  START_TIME 4.d6 y
  FINAL_TIME 5.d6 y
END
#==============================================================================