#==============================================================================
 # PFLOTRAN Input Deck
 # Description: 2D Hydrothermal Ridge and Flank System with Bottom Heat Input
 # Mode: TH (Thermal-Hydrology)
 #==============================================================================

 SIMULATION
   SIMULATION_TYPE SUBSURFACE
   PROCESS_MODELS
     SUBSURFACE_FLOW flow
       MODE TH
     /
   /
 END

 SUBSURFACE

 #=========================== discretization ===================================
 GRID
   TYPE STRUCTURED
   NXYZ 500 1 100          # 2D domain: 500 cells horizontally, 100 cells vertically
   BOUNDS
     0.d0   0.d0   -1000.d0 # m
     5000.d0 1.d0     0.d0  # m
   /
 END

 #=========================== material properties ==============================
 MATERIAL_PROPERTY crust
   ID 1
   POROSITY 0.10d0
   TORTUOSITY 1.d0
   ROCK_DENSITY 2700.d0 kg/m^3 # Typically density for Calcite. A bit different from quartz or basalt.
   SPECIFIC_HEAT 1000.d0 J/kg-C # Typically use 800 for basalt, water is ~4000
   THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
   THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C # Check if possible that the model can take water fraction into account for calculating this (effect in the few % range)
    
   PERMEABILITY
     PERM_ISO 1.d-14 # Possible some convection will arise at 2km thick for 14
   /
   CHARACTERISTIC_CURVES cc1
 /

 #=========================== characteristic curves ============================
 CHARACTERISTIC_CURVES cc1
   SATURATION_FUNCTION VAN_GENUCHTEN
     M 0.5d0
     ALPHA 1.d-4
     LIQUID_RESIDUAL_SATURATION 0.1d0
   /
   PERMEABILITY_FUNCTION MUALEM_VG_LIQ
     M 0.5d0
     LIQUID_RESIDUAL_SATURATION 0.1d0
     SMOOTH
   /
 END

 #=========================== output options ===================================
 OUTPUT
   TIMES yr 1.d5 2.d5 3.d5 4.d5 5.d5 6.d5 7.d5 8.d5 9.d5 1.d6
   FORMAT TECPLOT BLOCK
   VELOCITY_AT_CENTER
   VARIABLES
     LIQUID_PRESSURE
     TEMPERATURE
     LIQUID_DENSITY
   /
 END

 #=========================== times ============================================
 TIME
   FINAL_TIME 1.d6 yr
   INITIAL_TIMESTEP_SIZE 1.d3 yr
   MAXIMUM_TIMESTEP_SIZE 1.d5 yr
 END

 #=========================== regions ==========================================
 REGION all
   COORDINATES
     0.d0   0.d0   -1000.d0
     5000.d0 1.d0     0.d0
   /
 END

 REGION top_ocean_floor
   COORDINATES
     0.d0   0.d0   0.d0
     5000.d0 1.d0   0.d0
   /
   FACE TOP
 END

 REGION bottom_heat_source
   COORDINATES
     0.d0   0.d0   -1000.d0
     5000.d0 1.d0   -1000.d0
   /
   FACE BOTTOM
 END

 # NEW: Right edge vertical boundary region (x = 5000 m)
 REGION right_edge
   COORDINATES
     5000.d0 0.d0 -1000.d0
     5000.d0 1.d0    0.d0
   /
   FACE EAST
 END

 #=========================== flow conditions ==================================
 # Hydrostatic ocean floor boundary (Cold, high pressure)
 FLOW_CONDITION seafloor_bc
   TYPE
     LIQUID_PRESSURE DIRICHLET
     TEMPERATURE DIRICHLET
   /
   LIQUID_PRESSURE 2.d7 Pa
   TEMPERATURE 2.d0 C
 END

 # Deep Basal Heat Flux (The Ridge/Flank heat input)
 FLOW_CONDITION bottom_heating
   TYPE
     LIQUID_FLUX NEUMANN
     ENERGY_FLUX NEUMANN
   /
   LIQUID_FLUX 0.d0 m/yr
   ENERGY_FLUX 0.11d0 W/m^2
 END

 FLOW_CONDITION initial_crust
   TYPE
     LIQUID_PRESSURE HYDROSTATIC
     TEMPERATURE DIRICHLET
   /
   INTERPOLATION LINEAR
   DATUM 0.d0 0.d0 0.d0
   LIQUID_PRESSURE 2.d7 Pa
   TEMPERATURE 2.d0 C
 END

 # NEW: Hydrostatic right boundary (20 MPa at z=0 down to ~30 MPa at 1 km depth)
 FLOW_CONDITION right_hydrostatic_bc
   TYPE
     LIQUID_PRESSURE HYDROSTATIC
     TEMPERATURE DIRICHLET
   /
   INTERPOLATION LINEAR
   DATUM 0.d0 0.d0 0.d0
   LIQUID_PRESSURE 2.d7 Pa
   TEMPERATURE 2.d0 C
 END

 #=========================== condition couplers ===============================
 INITIAL_CONDITION
   FLOW_CONDITION initial_crust
   REGION all
 END

 BOUNDARY_CONDITION seafloor
   FLOW_CONDITION seafloor_bc
   REGION top_ocean_floor
 END

 BOUNDARY_CONDITION basal_heat
   FLOW_CONDITION bottom_heating
   REGION bottom_heat_source
 END

 # NEW: Boundary condition coupler for the right edge
 BOUNDARY_CONDITION right_edge_bc
   FLOW_CONDITION right_hydrostatic_bc
   REGION right_edge
 END

 #=========================== stratigraphy couplers ============================
 STRATA
   REGION all
   MATERIAL crust
 END

 #==============================================================================