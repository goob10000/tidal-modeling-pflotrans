#==============================================================================
# PFLOTRAN Input Deck
# Description: Stepped Hydrothermal Ridge System with Variable Depth Grid
#==============================================================================

# 2 degrees with insulating caps at all locations

# Completed
# Run Already

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
END

SUBSURFACE

#=========================== discretization ===================================
# Domain bounds: X in [0, 20000], Y in [0, 1], Z in [-5000, 0]
# 1. Top aquifer sits centered at X = 5000 to 15000.

GRID
  TYPE STRUCTURED
  NXYZ 572 1 116
  
  # ORIGIN sets the minimum bound (-5000 in Z)
  ORIGIN 0.d0 0.d0 -5000.d0
  
  DXYZ
    # DX:
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    440*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0 
    
    # DY:
    1.d0
    
    # DZ:
    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0 
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY crust
  ID 1
  POROSITY 0.10d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14 
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust1
  ID 2
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust2
  ID 3
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-15
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust3
  ID 4
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-16
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust4
  ID 5
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-17
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY deep_crust5
  ID 6
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-18
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY seamount_cap
  ID 7
  POROSITY 0.1d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 0.2d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 0.2d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14
  /
  CHARACTERISTIC_CURVES cc1
/

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
    SMOOTH
  /
END

#=========================== output options ===================================
OUTPUT
  TIMES yr 5.d5 10.d5 15.d5 20.d5 25.d5 30.d5 35.d5 40.d5 45.d5 50.d5
  FORMAT TECPLOT BLOCK
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 50.d5 yr
  INITIAL_TIMESTEP_SIZE 1.d2 yr # Reduced slightly to handle the initial transient of a deeper model
  MAXIMUM_TIMESTEP_SIZE 1.d5 yr
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    20000.d0 1.d0 -5000.d0
  /
END

REGION top_deep_layer
  COORDINATES
    5000.d0     0.d0   -1050.d0
    15000.d0 1.d0   -1000.d0
  /
END

REGION bottom_deep_layer
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -1050.d0
  /
END

# 2. Upper Layer / Aquifer (-1000 to -50 m, Centered X: 5000 to 15000)
REGION upper_layer
  COORDINATES
    5000.d0  0.d0   -1000.d0
    15000.d0 1.d0    -50.d0
  /
END

# 3. Cap Layer (-50 to 0 m, Centered X: 5000 to 15000)
REGION cap_layer
  COORDINATES
    5000.d0  0.d0    -50.d0
    15000.d0 1.d0      0.d0
  /
END

REGION top
  COORDINATES
    5000.d0 0.d0 -1000.d0
    15000.d0 1.d0 0.d0
  /
END

REGION upper_left
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
END

REGION upper_right
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 0.d0
  /
END

REGION right_cap_region
  COORDINATES
    15000.d0 0.d0 -1050.d0
    20000.d0 1.d0 -1000.d0
  /
END

REGION left_cap_region
  COORDINATES
    0.d0 0.d0 -1050.d0
    5000.d0 1.d0 -1000.d0
  /
END

#=========================== Boundaries ==========================================
REGION top_ocean_floor
  COORDINATES
    5000.d0  0.d0   0.d0
    15000.d0 1.d0   0.d0
  /
  FACE TOP
END

REGION bottom_heat_source
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -5000.d0
  /
  FACE BOTTOM
END

REGION top_left_hydrostat
  COORDINATES
    5000.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
  FACE WEST
END

REGION top_right_hydrostat
  COORDINATES
    15000.d0 0.d0 -1000.d0
    15000.d0 1.d0 0.d0
  /
  FACE EAST
END

REGION bottom_left
  COORDINATES
    0.d0 0.d0 -5000.d0
    0.d0 1.d0 -1050.d0
  /
  FACE WEST
END

REGION bottom_right
  COORDINATES
    20000.d0 0.d0 -5000.d0
    20000.d0 1.d0 -1050.d0
  /
  FACE EAST
END

REGION right_cap
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

REGION left_cap
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

#=========================== flow conditions ==================================
FLOW_CONDITION seafloor_bc
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 0.d0 m/y
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION bottom_heating
  TYPE
    LIQUID_FLUX NEUMANN
    ENERGY_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0 m/yr
  ENERGY_FLUX 0.11d0 W/m^2
END

FLOW_CONDITION initial_crust
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION hydrostatic_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial_crust
  REGION all
END

BOUNDARY_CONDITION seafloor
  FLOW_CONDITION seafloor_bc
  REGION top_ocean_floor
END

BOUNDARY_CONDITION basal_heat
  FLOW_CONDITION bottom_heating
  REGION bottom_heat_source
END

BOUNDARY_CONDITION top_right_edge_bc
  FLOW_CONDITION hydrostatic_bc
  REGION top_right_hydrostat
END

BOUNDARY_CONDITION top_left_edge_bc
  FLOW_CONDITION hydrostatic_bc
  REGION top_left_hydrostat
END

BOUNDARY_CONDITION right_cap_2deg
  FLOW_CONDITION seafloor_bc
  REGION left_cap
END

BOUNDARY_CONDITION left_cap_2deg
  FLOW_CONDITION seafloor_bc
  REGION right_cap
END

#=========================== stratigraphy couplers ============================

STRATA
  REGION cap_layer
  MATERIAL seamount_cap
END

STRATA
  REGION right_cap_region
  MATERIAL seamount_cap
END

STRATA
  REGION left_cap_region
  MATERIAL seamount_cap
END

STRATA
  REGION upper_layer
  MATERIAL crust
END

STRATA
  REGION upper_left
  INACTIVE
END

STRATA
  REGION upper_right
  INACTIVE
END

STRATA
  REGION top_deep_layer
  MATERIAL deep_crust1
  START_TIME 0.d0 y
  FINAL_TIME 1.d6 y
END

STRATA
  REGION top_deep_layer
  MATERIAL deep_crust2
  START_TIME 1.d6 y
  FINAL_TIME 2.d6 y
END

STRATA
  REGION top_deep_layer
  MATERIAL deep_crust3
  START_TIME 2.d6 y
  FINAL_TIME 3.d6 y
END

STRATA
  REGION top_deep_layer
  MATERIAL deep_crust4
  START_TIME 3.d6 y
  FINAL_TIME 4.d6 y
END

STRATA
  REGION top_deep_layer
  MATERIAL deep_crust5
  START_TIME 4.d6 y
  FINAL_TIME 5.d6 y
END

STRATA
  REGION bottom_deep_layer
  MATERIAL deep_crust1
  START_TIME 0.d0 y
  FINAL_TIME 1.d6 y
END

STRATA
  REGION bottom_deep_layer
  MATERIAL deep_crust2
  START_TIME 1.d6 y
  FINAL_TIME 2.d6 y
END

STRATA
  REGION bottom_deep_layer
  MATERIAL deep_crust3
  START_TIME 2.d6 y
  FINAL_TIME 3.d6 y
END

STRATA
  REGION bottom_deep_layer
  MATERIAL deep_crust4
  START_TIME 3.d6 y
  FINAL_TIME 4.d6 y
END

STRATA
  REGION bottom_deep_layer
  MATERIAL deep_crust5
  START_TIME 4.d6 y
  FINAL_TIME 5.d6 y
END

#==============================================================================