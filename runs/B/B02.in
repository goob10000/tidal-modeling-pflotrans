#==============================================================================
# PFLOTRAN Input Deck - Davidson Seamount
# Developed by Nathaniel Platt
#==============================================================================

# DESCRIPTION
# Restart based on B00 and output checkpoints for each step up in aquifer permeability for their starting points

# STATUS
# Completed
# 

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
  CHECKPOINT
    TIMES yr 10.d5 20.d5 30.d5 40.d5
    FORMAT HDF5
  /
  RESTART
    FILENAME B00_restart.h5
    RESET_TO_TIME_ZERO
  /
END

SUBSURFACE

#=========================== discretization ===================================
# Domain bounds: X in [0, 20000], Y in [0, 1], Z in [-5000, 0]
# 1. Top aquifer sits centered at X = 5000 to 15000.

GRID
  TYPE STRUCTURED
  NXYZ 572 1 116
  
  # ORIGIN sets the minimum bound (-5000 in Z)
  ORIGIN 0.d0 0.d0 -5000.d0
  
  ## Grid layout. Defined left to right for x and bottom to top for z
  DXYZ
    # DX:
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    440*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0 
    
    # DY:
    1.d0
    
    # DZ:
    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0 
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY heated_layer
  ID 1
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-18
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY seamount_cap_1
  ID 2
  POROSITY 0.1d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 0.2d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 0.2d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-13
  /
  CHARACTERISTIC_CURVES cc1
/

