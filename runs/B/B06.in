#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
    SMOOTH
  /
END

#=========================== output options ===================================
OUTPUT
  TIMES yr 0001.d3 0002.d3 0005.d3 0010.d3 0020.d3 0050.d3 0100.d3 0200.d3 0500.d3 1000.d3 1001.d3 1002.d3 1005.d3 1010.d3 1020.d3 1050.d3 1100.d3 1200.d3 1500.d3 2000.d3 2001.d3 2002.d3 2005.d3 2010.d3 2020.d3 2050.d3 2100.d3 2200.d3 2400.d3 2500.d3 2600.d3 2800.d3 3000.d3 3001.d3 3002.d3 3005.d3 3010.d3 3020.d3 3050.d3 3100.d3 3200.d3 3400.d3 3500.d3 3600.d3 3800.d3 4000.d3 4200.d3 4400.d3 4600.d3 4800.d3 5000.d3 5200.d3 5400.d3 5600.d3 5800.d3 6000.d3 6200.d3 6400.d3
  FORMAT TECPLOT BLOCK
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
    LIQUID_SATURATION
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 64.d5 yr
  INITIAL_TIMESTEP_SIZE 1.d2 yr
  MAXIMUM_TIMESTEP_SIZE 1.d5 yr
  MAXIMUM_TIMESTEP_SIZE 1.d0 yr at 2.0d6 yr
  MAXIMUM_TIMESTEP_SIZE 1.d5 yr at 2.4d6 yr
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    20000.d0 1.d0 -5000.d0
  /
END

REGION top_heated_layer
  COORDINATES
    5000.d0     0.d0   -1050.d0
    15000.d0 1.d0   -1000.d0
  /
END

REGION bottom_heated_layer
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -1050.d0
  /
END

REGION top_aquifer
  COORDINATES
    5000.d0  0.d0   -1000.d0
    15000.d0 1.d0    -350.d0
  /
END

REGION bottom_aquifer
  COORDINATES
    5000.d0  0.d0   -350.d0
    15000.d0 1.d0    -50.d0
  /
END

REGION top_insulating_cap
  COORDINATES
    5000.d0  0.d0    -50.d0
    15000.d0 1.d0      0.d0
  /
END

REGION upper_left_inactive
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
END

REGION upper_right_inactive
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 0.d0
  /
END

REGION right_insulating_cap
  COORDINATES
    15000.d0 0.d0 -1050.d0
    20000.d0 1.d0 -1000.d0
  /
END

REGION left_insulating_cap
  COORDINATES
    0.d0 0.d0 -1050.d0
    5000.d0 1.d0 -1000.d0
  /
END

#=========================== Boundaries ==========================================
REGION top_cap
  COORDINATES
    5000.d0  0.d0   0.d0
    15000.d0 1.d0   0.d0
  /
  FACE TOP
END

REGION bottom_boundary
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -5000.d0
  /
  FACE BOTTOM
END

REGION left_hydrostat
  COORDINATES
    5000.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
  FACE WEST
END

REGION right_hydrostat
  COORDINATES
    15000.d0 0.d0 -1000.d0
    15000.d0 1.d0 0.d0
  /
  FACE EAST
END

REGION bottom_left
  COORDINATES
    0.d0 0.d0 -5000.d0
    0.d0 1.d0 -1050.d0
  /
  FACE WEST
END

REGION bottom_right
  COORDINATES
    20000.d0 0.d0 -5000.d0
    20000.d0 1.d0 -1050.d0
  /
  FACE EAST
END

REGION right_cap
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

REGION left_cap
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

#=========================== flow conditions ==================================
FLOW_CONDITION no_fluid_2C
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 0.d0 m/y
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION bottom_heating
  TYPE
    LIQUID_FLUX NEUMANN
    ENERGY_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0 m/yr
  ENERGY_FLUX 0.11d0 W/m^2
END

FLOW_CONDITION initial_crust
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION hydrostatic_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial_crust
  REGION all
END

BOUNDARY_CONDITION top_cap_bc
  FLOW_CONDITION no_fluid_2C
  REGION top_cap
END

BOUNDARY_CONDITION bottom_boundary_bc
  FLOW_CONDITION bottom_heating
  REGION bottom_boundary
END
BOUNDARY_CONDITION right_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION right_hydrostat
END

BOUNDARY_CONDITION left_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION left_hydrostat
END


BOUNDARY_CONDITION right_cap_2deg
  FLOW_CONDITION no_fluid_2C
  REGION left_cap
END

BOUNDARY_CONDITION left_cap_2deg
  FLOW_CONDITION no_fluid_2C
  REGION right_cap
END

