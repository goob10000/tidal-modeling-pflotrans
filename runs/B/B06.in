#==============================================================================
# PFLOTRAN Input Deck - Davidson Seamount
# Developed by Nathaniel Platt
#==============================================================================

# DESCRIPTION
# Restart based on B00 and output checkpoints for each step up in aquifer permeability for their starting points

# STATUS
# Completed
# Run, died around 4.6E6

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
  CHECKPOINT
    TIMES yr 10.d5 20.d5 24.d5 26.d5 28.d5 30.d5 32.d5 34.d5 36.d5 38.d5 40.d5 42.d5 44.d5 46.d5 48.d5 50.d5 52.d5 54.d5 56.d5 58.d5 60.d5 62.d5 64.d5
    FORMAT HDF5
  /
  RESTART
    FILENAME B02-2000000.0000yr.h5
  /
END

SUBSURFACE

#=========================== discretization ===================================
# Domain bounds: X in [0, 20000], Y in [0, 1], Z in [-5000, 0]
# 1. Top aquifer sits centered at X = 5000 to 15000.

GRID
  TYPE STRUCTURED
  NXYZ 572 1 116

  # ORIGIN sets the minimum bound (-5000 in Z)
  ORIGIN 0.d0 0.d0 -5000.d0

  ## Grid layout. Defined left to right for x and bottom to top for z
  DXYZ
    # DX:
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    440*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0

    # DY:
    1.d0

    # DZ:
    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0
  /
END

#=========================== material properties ==============================
