#=========================== Boundaries ==========================================
REGION top_cap
  COORDINATES
    5000.d0  0.d0   0.d0
    15000.d0 1.d0   0.d0
  /
  FACE TOP
END

REGION bottom_boundary
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -5000.d0
  /
  FACE BOTTOM
END

REGION left_hydrostat
  COORDINATES
    5000.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
  FACE WEST
END

REGION right_hydrostat
  COORDINATES
    15000.d0 0.d0 -1000.d0
    15000.d0 1.d0 0.d0
  /
  FACE EAST
END

REGION bottom_left
  COORDINATES
    0.d0 0.d0 -5000.d0
    0.d0 1.d0 -1050.d0
  /
  FACE WEST
END

REGION bottom_right
  COORDINATES
    20000.d0 0.d0 -5000.d0
    20000.d0 1.d0 -1050.d0
  /
  FACE EAST
END

REGION right_cap
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

REGION left_cap
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

#=========================== flow conditions ==================================
FLOW_CONDITION no_fluid_2C
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 0.d0 m/y
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION bottom_heating
  TYPE
    LIQUID_FLUX NEUMANN
    ENERGY_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0 m/yr
  ENERGY_FLUX 0.11d0 W/m^2
END

FLOW_CONDITION initial_crust
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION hydrostatic_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial_crust
  REGION all
END

BOUNDARY_CONDITION top_cap_bc
  FLOW_CONDITION no_fluid_2C
  REGION top_cap
END

BOUNDARY_CONDITION bottom_boundary_bc
  FLOW_CONDITION bottom_heating
  REGION bottom_boundary
END
BOUNDARY_CONDITION right_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION right_hydrostat
END

BOUNDARY_CONDITION left_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION left_hydrostat
END


BOUNDARY_CONDITION right_cap_2deg
  FLOW_CONDITION no_fluid_2C
  REGION left_cap
END

BOUNDARY_CONDITION left_cap_2deg
  FLOW_CONDITION no_fluid_2C
  REGION right_cap
END

