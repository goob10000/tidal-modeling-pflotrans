#==============================================================================
# PFLOTRAN Input Deck - Davidson Seamount
# Developed by Nathaniel Platt
#==============================================================================

# DESCRIPTION
# [X] Restart off 4.6E6 B06
# [X] Properly set max timesteps
# [X] Set max dPdt and dTdt
# [X] Set more frequent logging and checkpoints
# [X] Set more frequent logging of a subset of nodes
# [X] Heated layer permeability to 10^-17

# STATUS
# Completed
# Running

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
  CHECKPOINT
    PERIODIC TIME 10000. y
    FORMAT HDF5
  /
  RESTART 
    # FILENAME B06-4600000.0000yr.h5 -> switched to checkpoint reached at 1million steps
    # FILENAME B09-restart-max-ts.h5
    FILENAME B09-5710000.0000y.h5
  /
END

SUBSURFACE
  NUMERICAL_METHODS FLOW
    TIMESTEPPER
      PRESSURE_CHANGE_GOVERNOR 1.d5
      TEMPERATURE_CHANGE_GOVERNOR 0.5d0
      MAXIMUM_NUMBER_OF_TIMESTEPS 10000000
    /
  /

#=========================== discretization ===================================
# Domain bounds: X in [0, 20000], Y in [0, 1], Z in [-5000, 0]
# 1. Top aquifer sits centered at X = 5000 to 15000.

GRID
  TYPE STRUCTURED
  NXYZ 572 1 116

  # ORIGIN sets the minimum bound (-5000 in Z)
  ORIGIN 0.d0 0.d0 -5000.d0

  ## Grid layout. Defined left to right for x and bottom to top for z
  DXYZ
    # DX:
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    440*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0

    # DY:
    1.d0

    # DZ:
    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0
  /
END

#=========================== material properties ==============================
