#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
    SMOOTH
  /
END

#=========================== output options ===================================
OUTPUT
  PERIODIC TIME 10000. yr
  FORMAT TECPLOT BLOCK
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
    LIQUID_SATURATION
  /
  OBSERVATION_FILE
    PERIODIC TIME 1000. yr
    VELOCITY_AT_CENTER
    VARIABLES
      LIQUID_PRESSURE
      TEMPERATURE
      LIQUID_DENSITY
    /
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 41.d5 yr
  INITIAL_TIMESTEP_SIZE 1.d2 yr
  MAXIMUM_TIMESTEP_SIZE 3.d3 yr
  MAXIMUM_TIMESTEP_SIZE 3.d2 yr at 1.1d6 yr
  MAXIMUM_TIMESTEP_SIZE 3.d1 yr at 2.1d6 yr
  MAXIMUM_TIMESTEP_SIZE 3.d0 yr at 3.1d6 yr
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    20000.d0 1.d0 -5000.d0
  /
END

REGION top_heated_layer
  COORDINATES
    5000.d0     0.d0   -1050.d0
    15000.d0 1.d0   -1000.d0
  /
END

REGION bottom_heated_layer
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -1050.d0
  /
END

REGION top_aquifer
  COORDINATES
    5000.d0  0.d0   -1000.d0
    15000.d0 1.d0    -350.d0
  /
END

REGION bottom_aquifer
  COORDINATES
    5000.d0  0.d0    -350.d0
    15000.d0 1.d0     -50.d0
  /
END

REGION top_insulating_cap
  COORDINATES
    5000.d0  0.d0     -50.d0
    15000.d0 1.d0       0.d0
  /
END

REGION upper_left_inactive
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
END

REGION upper_right_inactive
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 0.d0
  /
END

REGION right_insulating_cap
  COORDINATES
    15000.d0 0.d0 -1050.d0
    20000.d0 1.d0 -1000.d0
  /
END

REGION left_insulating_cap
  COORDINATES
    0.d0 0.d0 -1050.d0
    5000.d0 1.d0 -1000.d0
  /
END

