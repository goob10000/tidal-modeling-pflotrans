#==============================================================================
# PFLOTRAN Input Deck - Davidson Seamount
# Developed by Nathaniel Platt
#==============================================================================

# DESCRIPTION
# [X] Restart off end of B01
# [X] Set lower aquifer to 1e-17 permeability
# [X] Set dts 3000, 300, 30, 3
# [X] Set logging of velocity to pft files

# STATUS
# Completed
# Running

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
  CHECKPOINT
    PERIODIC TIME 10000. y
    FORMAT HDF5
  /
  RESTART 
    FILENAME B01-restart.h5
    RESET_TO_TIME_ZERO
  /
END

SUBSURFACE
  NUMERICAL_METHODS FLOW
    TIMESTEPPER
      PRESSURE_CHANGE_GOVERNOR 1.d5
      TEMPERATURE_CHANGE_GOVERNOR 0.5d0
      MAXIMUM_NUMBER_OF_TIMESTEPS 10000000
    /
  /

GRID
  TYPE STRUCTURED
  NXYZ 572 1 116
  ORIGIN 0.d0 0.d0 -5000.d0
  DXYZ
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    440*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0

    1.d0

    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY heated_layer
  ID 1
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3
  SPECIFIC_HEAT 1000.d0 J/kg-C
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C
  PERMEABILITY
    PERM_ISO 1.d-17
  /
  CHARACTERISTIC_CURVES cc1
/

