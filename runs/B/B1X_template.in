#==============================================================================
# PFLOTRAN Input Deck - Davidson Seamount
# Developed by Nathaniel Platt
#==============================================================================

# DESCRIPTION
# Template for the B1 series simulations

# STATUS
# 
# 

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
  /
  CHECKPOINT
    PERIODIC TIME 10000. y
    FORMAT HDF5
  /
  RESTART
    FILENAME restart.h5
    RESET_TO_TIME_ZERO
  /
END

SUBSURFACE
  NUMERICAL_METHODS FLOW
    TIMESTEPPER
      PRESSURE_CHANGE_GOVERNOR 1.d5
      TEMPERATURE_CHANGE_GOVERNOR 0.5d0
      MAXIMUM_NUMBER_OF_TIMESTEPS 10000000
    /
  /

#=========================== discretization ===================================
# Domain bounds: X in [0, 20000], Y in [0, 1], Z in [-5000, 0]
# 1. Top aquifer sits centered at X = 5000 to 15000.

GRID
  TYPE STRUCTURED
  NXYZ 572 1 116
  
  # ORIGIN sets the minimum bound (-5000 in Z)
  ORIGIN 0.d0 0.d0 -5000.d0
  
  ## Grid layout. Defined left to right for x and bottom to top for z
  DXYZ
    # DX:
    21*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    440*25.d0\
    15*35.d0 \
    15*50.d0 \
    15*75.d0 \
    21*100.d0 
    
    # DY:
    1.d0
    
    # DZ:
    11*100.d0 \
    15*75.d0 \
    15*50.d0 \
    15*35.d0 \
    60*25.d0 
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY heated_layer
  ID 1
  POROSITY 0.005d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-17
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY seamount_cap_1
  ID 2
  POROSITY 0.1d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 0.2d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 0.2d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14
  /
  CHARACTERISTIC_CURVES cc1
/

MATERIAL_PROPERTY aquifer_1
  ID 3
  POROSITY 0.10d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2700.d0 kg/m^3 
  SPECIFIC_HEAT 1000.d0 J/kg-C 
  THERMAL_CONDUCTIVITY_DRY 2.0d0 W/m-C
  THERMAL_CONDUCTIVITY_WET 2.0d0 W/m-C 
  PERMEABILITY
    PERM_ISO 1.d-14 
  /
  CHARACTERISTIC_CURVES cc1
/

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA 1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
    SMOOTH
  /
END

#=========================== output options ===================================
OUTPUT
  PERIODIC TIME 10000. yr
  FORMAT TECPLOT BLOCK
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
    LIQUID_SATURATION
  /
  OBSERVATION_FILE
    PERIODIC TIME 1000. yr
    VARIABLES
      LIQUID_PRESSURE
      TEMPERATURE
      LIQUID_DENSITY
    /
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 4.d6 yr
  INITIAL_TIMESTEP_SIZE 3.d0 yr
  MAXIMUM_TIMESTEP_SIZE 3.d0 yr
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    20000.d0 1.d0 -5000.d0
  /
END

REGION top_heated_layer
  COORDINATES
    5000.d0     0.d0   -1050.d0
    15000.d0 1.d0   -1000.d0
  /
END

REGION bottom_heated_layer
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -1050.d0
  /
END

REGION top_aquifer
  COORDINATES
    5000.d0  0.d0   -1000.d0
    15000.d0 1.d0    -350.d0
  /
END

REGION bottom_aquifer
  COORDINATES
    5000.d0  0.d0   -350.d0
    15000.d0 1.d0    -50.d0
  /
END

REGION top_insulating_cap
  COORDINATES
    5000.d0  0.d0    -50.d0
    15000.d0 1.d0      0.d0
  /
END

REGION upper_left_inactive
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
END

REGION upper_right_inactive
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 0.d0
  /
END

REGION right_insulating_cap
  COORDINATES
    15000.d0 0.d0 -1050.d0
    20000.d0 1.d0 -1000.d0
  /
END

REGION left_insulating_cap
  COORDINATES
    0.d0 0.d0 -1050.d0
    5000.d0 1.d0 -1000.d0
  /
END


#=========================== logging points ==========================================

REGION location_1
  COORDINATE 5200.0 1.0 -950.0
/

REGION location_2
  COORDINATE 6400.0 1.0 -950.0
/

REGION location_3
  COORDINATE 7600.0 1.0 -950.0
/

REGION location_4
  COORDINATE 8800.0 1.0 -950.0
/

REGION location_5
  COORDINATE 10000.0 1.0 -950.0
/

REGION location_6
  COORDINATE 11200.0 1.0 -950.0
/

REGION location_7
  COORDINATE 12400.0 1.0 -950.0
/

REGION location_8
  COORDINATE 13600.0 1.0 -950.0
/

REGION location_9
  COORDINATE 14800.0 1.0 -950.0
/

REGION location_10
  COORDINATE 5200.0 1.0 -500.0
/

REGION location_11
  COORDINATE 6400.0 1.0 -500.0
/

REGION location_12
  COORDINATE 7600.0 1.0 -500.0
/

REGION location_13
  COORDINATE 8800.0 1.0 -500.0
/

REGION location_14
  COORDINATE 10000.0 1.0 -500.0
/

REGION location_15
  COORDINATE 11200.0 1.0 -500.0
/

REGION location_16
  COORDINATE 12400.0 1.0 -500.0
/

REGION location_17
  COORDINATE 13600.0 1.0 -500.0
/

REGION location_18
  COORDINATE 14800.0 1.0 -500.0
/

OBSERVATION
  REGION location_1
/

OBSERVATION
  REGION location_2
/

OBSERVATION
  REGION location_3
/

OBSERVATION
  REGION location_4
/

OBSERVATION
  REGION location_5
/

OBSERVATION
  REGION location_6
/

OBSERVATION
  REGION location_7
/

OBSERVATION
  REGION location_8
/

OBSERVATION
  REGION location_9
/

OBSERVATION
  REGION location_10
/

OBSERVATION
  REGION location_11
/

OBSERVATION
  REGION location_12
/

OBSERVATION
  REGION location_13
/

OBSERVATION
  REGION location_14
/

OBSERVATION
  REGION location_15
/

OBSERVATION
  REGION location_16
/

OBSERVATION
  REGION location_17
/

OBSERVATION
  REGION location_18
/

#=========================== Boundaries ==========================================
REGION top_cap
  COORDINATES
    5000.d0  0.d0   0.d0
    15000.d0 1.d0   0.d0
  /
  FACE TOP
END

REGION bottom_boundary
  COORDINATES
    0.d0     0.d0   -5000.d0
    20000.d0 1.d0   -5000.d0
  /
  FACE BOTTOM
END

REGION left_hydrostat
  COORDINATES
    5000.d0 0.d0 -1000.d0
    5000.d0 1.d0 0.d0
  /
  FACE WEST
END

REGION right_hydrostat
  COORDINATES
    15000.d0 0.d0 -1000.d0
    15000.d0 1.d0 0.d0
  /
  FACE EAST
END

REGION bottom_left
  COORDINATES
    0.d0 0.d0 -5000.d0
    0.d0 1.d0 -1050.d0
  /
  FACE WEST
END

REGION bottom_right
  COORDINATES
    20000.d0 0.d0 -5000.d0
    20000.d0 1.d0 -1050.d0
  /
  FACE EAST
END

REGION right_cap
  COORDINATES
    15000.d0 0.d0 -1000.d0
    20000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

REGION left_cap
  COORDINATES
    0.d0 0.d0 -1000.d0
    5000.d0 1.d0 -1000.d0
  /
  FACE TOP
END

#=========================== flow conditions ==================================
FLOW_CONDITION no_fluid_2C
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 0.d0 m/y
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION bottom_heating
  TYPE
    LIQUID_FLUX NEUMANN
    ENERGY_FLUX NEUMANN
  /
  LIQUID_FLUX 0.d0 m/yr
  ENERGY_FLUX 0.11d0 W/m^2
END

FLOW_CONDITION initial_crust
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION hydrostatic_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  LIQUID_PRESSURE 2.d7 Pa
  TEMPERATURE 2.d0 C
END

FLOW_CONDITION hydrostaticNpush_bc
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
    TEMPERATURE DIRICHLET
  /
  INTERPOLATION LINEAR
  LIQUID_PRESSURE 202.d5 Pa
  TEMPERATURE 2.d0 C
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial_crust
  REGION all
END

BOUNDARY_CONDITION top_cap_bc
  FLOW_CONDITION no_fluid_2C
  REGION top_cap
END

BOUNDARY_CONDITION bottom_boundary_bc
  FLOW_CONDITION bottom_heating
  REGION bottom_boundary
END

BOUNDARY_CONDITION right_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION right_hydrostat
END

BOUNDARY_CONDITION left_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION left_hydrostat
  START_TIME 0.d6 y
  FINAL_TIME 1.d6 y
END

BOUNDARY_CONDITION left_hydrostat_bc
  FLOW_CONDITION hydrostaticNpush_bc
  REGION left_hydrostat
  START_TIME 1.d6 y
  FINAL_TIME 2.d6 y
END

BOUNDARY_CONDITION left_hydrostat_bc
  FLOW_CONDITION hydrostatic_bc
  REGION left_hydrostat
  START_TIME 2.d6 y
  FINAL_TIME 4.d6 y
END


BOUNDARY_CONDITION right_cap_2deg
  FLOW_CONDITION no_fluid_2C
  REGION left_cap
END

BOUNDARY_CONDITION left_cap_2deg
  FLOW_CONDITION no_fluid_2C
  REGION right_cap
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION top_insulating_cap
  MATERIAL seamount_cap
END

STRATA
  REGION right_insulating_cap
  MATERIAL seamount_cap
END

STRATA
  REGION left_insulating_cap
  MATERIAL seamount_cap
END

STRATA
  REGION top_aquifer
  MATERIAL aquifer
END

STRATA
  REGION bottom_aquifer
  MATERIAL aquifer
END

STRATA
  REGION upper_left_inactive
  INACTIVE
END

STRATA
  REGION upper_right_inactive
  INACTIVE
END

STRATA
  REGION top_heated_layer
  MATERIAL heated_layer
END

STRATA
  REGION bottom_heated_layer
  MATERIAL heated_layer
END

#==============================================================================